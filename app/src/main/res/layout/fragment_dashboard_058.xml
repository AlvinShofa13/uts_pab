<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_058">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Welcome User -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/outline_058"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/card_background_058">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_welcome_user_058"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:textColor="@color/primary_058"
                    android:textStyle="bold"
                    tools:text="Selamat Datang, Admin!" />

                <TextView
                    android:id="@+id/tv_title_dashboard_058"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/title_dashboard_058"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@color/text_secondary_058" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Real-time Total Nilai Inventaris Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/primary_058">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_total_nilai_058"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="#D0E0FC"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_total_nilai_058"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Rp 0"
                    android:textAppearance="?attr/textAppearanceHeadline4"
                    android:textColor="@color/white_058"
                    android:textStyle="bold"
                    tools:text="Rp 12.500.000" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Total Jenis Barang -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/outline_058"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/card_background_058">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_total_jenis_058"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="@color/text_secondary_058" />

                <TextView
                    android:id="@+id/tv_total_jenis_058"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0 Barang"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:textColor="@color/black_058"
                    android:textStyle="bold"
                    tools:text="5 Jenis Barang" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigation Buttons -->
        <Button
            android:id="@+id/btn_view_list_058"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            app:cornerRadius="10dp"
            android:text="@string/btn_view_list_058"
            android:backgroundTint="@color/primary_058"
            app:icon="@drawable/ic_list_24"
            app:iconTint="@color/white_058" />

        <Button
            android:id="@+id/btn_add_item_058"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            app:cornerRadius="10dp"
            android:text="@string/btn_add_item_058"
            android:textColor="@color/primary_058"
            app:strokeColor="@color/primary_058"
            app:strokeWidth="1.5dp"
            app:icon="@drawable/ic_add_24"
            app:iconTint="@color/primary_058" />

        <Button
            android:id="@+id/btn_logout_058"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            app:cornerRadius="10dp"
            android:text="@string/btn_logout_058"
            android:textColor="@color/error_058"
            app:strokeColor="@color/error_058"
            app:strokeWidth="1.5dp"
            app:icon="@drawable/ic_logout_24"
            app:iconTint="@color/error_058" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
