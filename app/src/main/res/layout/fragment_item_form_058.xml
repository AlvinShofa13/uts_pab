<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_058">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Form Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/outline_058"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/card_background_058">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Header Badge & Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="6dp"
                        android:background="@drawable/ic_inventory_24"
                        android:backgroundTint="@color/surface_container_058"
                        android:src="@drawable/ic_inventory_24"
                        app:tint="@color/primary_058"
                        android:contentDescription="Form Header Icon" />

                    <TextView
                        android:id="@+id/tv_title_form_058"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/title_add_item_058"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/primary_058"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Field 1: Nama Barang -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_nama_barang_058"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/label_nama_barang_058"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/primary_058"
                    app:placeholderText="@string/hint_nama_barang_058"
                    app:startIconDrawable="@drawable/ic_label_24"
                    app:startIconTint="@color/primary_058">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_nama_barang_058"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Field 2: Jumlah Barang -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_jumlah_barang_058"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/label_jumlah_barang_058"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/primary_058"
                    app:placeholderText="@string/hint_jumlah_barang_058"
                    app:startIconDrawable="@drawable/ic_tag_24"
                    app:startIconTint="@color/primary_058">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_jumlah_barang_058"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Field 3: Harga Satuan -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_harga_barang_058"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    android:hint="@string/label_harga_barang_058"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/primary_058"
                    app:placeholderText="@string/hint_harga_barang_058"
                    app:startIconDrawable="@drawable/ic_payments_24"
                    app:startIconTint="@color/primary_058">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_harga_barang_058"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Button Simpan -->
                <Button
                    android:id="@+id/btn_save_item_058"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:padding="14dp"
                    app:cornerRadius="10dp"
                    android:text="@string/btn_save_058"
                    android:backgroundTint="@color/primary_058"
                    app:icon="@drawable/ic_add_24"
                    app:iconTint="@color/white_058" />

                <!-- Button Hapus (Visible only when editing an existing item) -->
                <Button
                    android:id="@+id/btn_delete_item_058"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    app:cornerRadius="10dp"
                    android:text="@string/btn_delete_058"
                    android:textColor="@color/error_058"
                    android:visibility="gone"
                    app:strokeColor="@color/error_058"
                    app:strokeWidth="1.5dp"
                    app:icon="@drawable/ic_delete_24"
                    app:iconTint="@color/error_058" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
