<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_058">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/outline_058"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/card_background_058">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:src="@drawable/ic_inventory_24"
                    app:tint="@color/primary_058"
                    android:contentDescription="Logo Inventaris" />

                <TextView
                    android:id="@+id/tv_title_login_058"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/title_login_058"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textColor="@color/primary_058"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_subtitle_login_058"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:text="@string/subtitle_login_058"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@color/text_secondary_058" />

                <!-- Username Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_username_058"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/label_username_058"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/primary_058"
                    app:startIconDrawable="@drawable/ic_person_24"
                    app:startIconTint="@color/primary_058">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_username_058"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password_058"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:hint="@string/label_password_058"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/primary_058"
                    app:passwordToggleEnabled="true"
                    app:startIconDrawable="@drawable/ic_lock_24"
                    app:startIconTint="@color/primary_058">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password_058"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Button Login -->
                <Button
                    android:id="@+id/btn_login_058"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:padding="14dp"
                    app:cornerRadius="10dp"
                    android:text="@string/btn_login_058"
                    android:backgroundTint="@color/primary_058" />

                <!-- Register Link -->
                <TextView
                    android:id="@+id/tv_register_link_058"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/link_register_058"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@color/primary_058"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
